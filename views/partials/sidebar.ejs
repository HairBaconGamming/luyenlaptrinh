<aside class="sidebar">
    <h2><a href="/" style="text-decoration: none; color: inherit;">Lộ trình Học tập</a></h2>
    
    <h3>Nền tảng</h3>
    <ul>
        <!-- You can add foundation links here -->
    </ul>
    
    <h3>Đệ quy</h3>
    <ul>
        <% for (let i = 0; i < topics.length; i++) { %>
            <% let topic = topics[i]; %>
            <% if (topic.category === 'de-quy') { %>
                <li>
                    <a href="/topic/<%= topic.id %>" class="<%= currentTopicId === topic.id ? 'active' : '' %>">
                        <%= topic.title %>
                    </a>
                </li>
            <% } %>
        <% } %>
    </ul>

